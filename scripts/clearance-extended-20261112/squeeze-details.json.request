{"name": "exec_editor_script", "arguments": {"script": "var original=UnityEngine.SceneManagement.SceneManager.GetActiveScene();if(original.isDirty)throw new System.Exception(\"Preserving dirty scene\");var reports=new System.Collections.Generic.List<object>();\ntry{foreach(var scenePath in new[]{\"Assets/Scenes/Level02_Jungle.unity\",\"Assets/Scenes/Level03_Beach.unity\"}){\nvar scene=UnityEditor.SceneManagement.EditorSceneManager.OpenScene(scenePath);var all=scene.GetRootGameObjects().SelectMany(r=>r.GetComponentsInChildren<UnityEngine.Collider2D>(true)).ToArray();var movers=all.Where(c=>c.enabled&&(c.GetComponent<VerticalRidePlatform>()!=null||c.GetComponent<OrbitRidePlatform>()!=null)).ToArray();var positions=movers.Select(c=>c.transform.position).ToArray();\nvar terrain=all.Where(c=>c.enabled&&!c.isTrigger&&c.name!=\"Closed door seal\"&&(c.attachedRigidbody==null||c.attachedRigidbody.bodyType!=UnityEngine.RigidbodyType2D.Dynamic)).ToArray();var body=all.First(c=>c.name==\"Cauldron\");var origin=body.bounds.center;var foot=origin.y-body.bounds.min.y;var go=new UnityEngine.GameObject(\"Temporary moving-platform body probe\");var probes=new System.Collections.Generic.List<UnityEngine.PolygonCollider2D>();\ntry{foreach(var source in all.OfType<UnityEngine.PolygonCollider2D>().Where(c=>c.enabled&&(c.name==\"Cauldron\"||c.name==\"Mario\"))){var pc=go.AddComponent<UnityEngine.PolygonCollider2D>();pc.pathCount=source.pathCount;for(int j=0;j<source.pathCount;j++)pc.SetPath(j,source.GetPath(j).Select(v=>(UnityEngine.Vector2)(source.transform.TransformPoint(v+source.offset)-origin)).ToArray());probes.Add(pc);}\nvar rows=new System.Collections.Generic.List<object>();foreach(var mover in movers){var safe=new System.Collections.Generic.List<int>();var blocked=new System.Collections.Generic.List<int>();var details=new System.Collections.Generic.List<object>();float worstBest=100;float period=mover.GetComponent<VerticalRidePlatform>()!=null?mover.GetComponent<VerticalRidePlatform>().period:mover.GetComponent<OrbitRidePlatform>().period;\nfor(int k=0;k<64;k++){float time=k/64f*period;for(int m=0;m<movers.Length;m++){var v=movers[m].GetComponent<VerticalRidePlatform>();var o=movers[m].GetComponent<OrbitRidePlatform>();if(v!=null){float t=(1-UnityEngine.Mathf.Cos((time/UnityEngine.Mathf.Max(v.period,.5f)+v.phase)*UnityEngine.Mathf.PI*2))*.5f;movers[m].transform.position=positions[m]+UnityEngine.Vector3.up*(v.travel*t);}else if(o!=null){float angle=(o.phase+time/UnityEngine.Mathf.Max(o.period,.5f))*UnityEngine.Mathf.PI*2;movers[m].transform.position=o.center+new UnityEngine.Vector2(UnityEngine.Mathf.Cos(angle),UnityEngine.Mathf.Sin(angle))*o.radius;}}\nUnityEngine.Physics2D.SyncTransforms();float best=-100;string bestObstacle=\"\";var bounds=mover.bounds;\nforeach(float offset in new[]{-.3f,-.15f,0f,.15f,.3f}){go.transform.position=new UnityEngine.Vector3(bounds.center.x+offset,bounds.max.y+foot+.025f);UnityEngine.Physics2D.SyncTransforms();float min=100;string obstacle=\"\";foreach(var pc in probes){var region=pc.bounds;region.Expand(.1f);foreach(var c in terrain)if(c!=mover&&region.Intersects(c.bounds)){var d=pc.Distance(c);if(d.isValid&&d.distance<min){min=d.distance;obstacle=c.name;}}}if(min>best){best=min;bestObstacle=obstacle;}}\nworstBest=UnityEngine.Mathf.Min(worstBest,best);if(best>.01f)safe.Add(k);else {blocked.Add(k);if(details.Count<3)details.Add(new{phase=k,obstacle=bestObstacle,penetration=-best});}\n}rows.Add(new{name=mover.name,safePhases=safe.Count,blockedPhases=blocked,details=details,worstBestClearance=worstBest,period=period});}\nreports.Add(new{scene=scenePath,platforms=rows});System.IO.File.WriteAllText(\"scripts/clearance-extended-20261112/squeeze-details.json\",Codely.Newtonsoft.Json.JsonConvert.SerializeObject(reports));UnityEngine.Debug.Log(scenePath+\" moving platforms=\"+movers.Length);\n}finally{UnityEngine.Object.DestroyImmediate(go);}\n}}finally{UnityEditor.SceneManagement.EditorSceneManager.OpenScene(\"Assets/Scenes/Level01.unity\");}\n", "summary": "Identify which actual obstacles overlap body positions on rotating platforms", "timeoutSeconds": 300}}