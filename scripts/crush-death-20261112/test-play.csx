GameMenuUI.Testing=true;GameMenuUI.PreferencePrefix="Goombas.CrushAcceptance."+System.Guid.NewGuid()+".";
var checks=new System.Collections.Generic.List<object>();void Assert(bool ok,string name){checks.Add(new{name=name,pass=ok});if(!ok)throw new System.Exception(name);}
var mode=UnityEngine.Physics2D.simulationMode;
try{
Assert(CampaignLevel.Current==null,"isolated scene has no campaign progress writer");var death=UnityEngine.Object.FindObjectOfType<Character.Lifecycle.Death>();Assert(death!=null&&!death.Dead,"actor starts alive");var detector=death.GetComponent<Character.Lifecycle.PlayerCrushDetection>();Assert(detector!=null,"Death.Awake installs crush detector automatically");Assert(death.GetComponent<PlayerUnstuck>()==null||!death.GetComponent<PlayerUnstuck>().enabled,"legacy automatic recovery not active");int events=0;death.OnCharacterDeath+=()=>events++;
var body=death.GetComponent<UnityEngine.Rigidbody2D>();
UnityEngine.BoxCollider2D Box(string name,UnityEngine.Vector2 pos,UnityEngine.Vector2 size,bool moving=false){var go=new UnityEngine.GameObject(name);go.transform.position=pos;go.layer=6;var col=go.AddComponent<UnityEngine.BoxCollider2D>();col.size=size;if(moving)go.AddComponent<UnityEngine.Rigidbody2D>().bodyType=UnityEngine.RigidbodyType2D.Kinematic;return col;}
var floor=Box("Test floor",new UnityEngine.Vector2(0,-1.249f),new UnityEngine.Vector2(8,1));var roof=Box("Test ceiling",new UnityEngine.Vector2(0,1.26f),new UnityEngine.Vector2(8,1));var left=Box("Test fixed wall",new UnityEngine.Vector2(-.91f,0),new UnityEngine.Vector2(1,6));var right=Box("Test closing wall",new UnityEngine.Vector2(1.4f,0),new UnityEngine.Vector2(1,6),true);
UnityEngine.Physics2D.simulationMode=UnityEngine.SimulationMode2D.Script;UnityEngine.Physics2D.SyncTransforms();for(int i=0;i<5;i++){UnityEngine.Physics2D.Simulate(.02f);detector.SendMessage("FixedUpdate");}Assert(!death.Dead&&events==0,"ordinary resting contacts do not kill in actual Play");
int step=0;for(;step<100&&!death.Dead;step++){right.attachedRigidbody.MovePosition(right.attachedRigidbody.position+UnityEngine.Vector2.left*.01f);UnityEngine.Physics2D.Simulate(.02f);detector.SendMessage("FixedUpdate");}
Assert(death.Dead,"actual moving-wall squeeze triggers Death");Assert(events==1,"death notification emitted exactly once");Assert(death.GetComponent<Character.Lifecycle.DeathFeedback>()!=null&&!death.GetComponent<Character.Lifecycle.DeathFeedback>().Falling,"uses existing impact death presentation");Assert(!body.simulated&&!death.GetComponent<UnityEngine.Collider2D>().enabled,"death releases body collision / simulation");death.Kill();Assert(events==1,"repeat kill is ignored");UnityEngine.Debug.Log("PLAY_CRUSH_PASS checks="+checks.Count+" squeeze step="+step);
}finally{
System.IO.File.WriteAllText("scripts/crush-death-20261112/play-results.json",Codely.Newtonsoft.Json.JsonConvert.SerializeObject(checks));UnityEngine.Physics2D.simulationMode=mode;UnityEditor.EditorApplication.isPlaying=false;
}
