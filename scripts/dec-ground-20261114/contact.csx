UnityEngine.Physics2D.SyncTransforms();var lines=new System.Collections.Generic.List<string>();foreach(var r in UnityEngine.Object.FindObjectsOfType<UnityEngine.SpriteRenderer>().Where(r=>r.name.StartsWith("DEC "))){var b=r.bounds;var hits=UnityEngine.Physics2D.RaycastAll(new UnityEngine.Vector2(b.center.x,b.min.y+.3f),UnityEngine.Vector2.down,300).Where(h=>h.collider is UnityEngine.Tilemaps.TilemapCollider2D||h.collider is UnityEngine.CompositeCollider2D).OrderBy(h=>h.distance).ToArray();if(hits.Length==0){r.gameObject.SetActive(false);lines.Add("Disabled unsupported "+r.name);continue;}float dy=hits[0].point.y-b.min.y-.04f;r.transform.position+=UnityEngine.Vector3.up*dy;lines.Add(r.name+" adjusted="+dy);}var s=UnityEngine.SceneManagement.SceneManager.GetActiveScene();UnityEditor.SceneManagement.EditorSceneManager.MarkSceneDirty(s);UnityEditor.SceneManagement.EditorSceneManager.SaveScene(s);System.IO.File.WriteAllLines("scripts/dec-ground-20261114/collider-contact.txt",lines);
