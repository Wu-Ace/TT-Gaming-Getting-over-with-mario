var scene=UnityEngine.SceneManagement.SceneManager.GetActiveScene();if(scene.name!="Level05_Cave"||UnityEditor.EditorApplication.isPlaying)throw new System.Exception("Wrong scene or Play");System.IO.File.Copy(scene.path,"scripts/dec-ground-20261114/disk.before",true);UnityEditor.SceneManagement.EditorSceneManager.SaveScene(scene,"Assets/Scenes/Level05-decoration-live-backup.unity",true);
var spans=new System.Collections.Generic.List<UnityEngine.Vector3>();foreach(var map in UnityEngine.Object.FindObjectsOfType<UnityEngine.Tilemaps.Tilemap>())foreach(var cell in map.cellBounds.allPositionsWithin)if(map.HasTile(cell)&&!map.HasTile(cell+UnityEngine.Vector3Int.up)){var p=map.GetCellCenterWorld(cell);var z=map.layoutGrid.cellSize;spans.Add(new UnityEngine.Vector3(p.x-z.x/2,p.x+z.x/2,p.y+z.y/2));}
var report=new System.Collections.Generic.List<string>();foreach(var r in UnityEngine.Object.FindObjectsOfType<UnityEngine.SpriteRenderer>().Where(r=>r.name.StartsWith("DEC "))){var b=r.bounds;var candidates=spans.Where(p=>b.center.x>=p.x&&b.center.x<=p.y&&p.z<=b.min.y+.3f).OrderBy(p=>UnityEngine.Mathf.Abs(p.z-b.min.y)).ToArray();if(candidates.Length==0){report.Add("NO SUPPORT "+r.name+" "+b.center);continue;}float dy=candidates[0].z-b.min.y-.04f;if(UnityEngine.Mathf.Abs(dy)<.1f)continue;report.Add(r.name+" "+r.transform.position+" dy="+dy);r.transform.position+=UnityEngine.Vector3.up*dy;UnityEditor.EditorUtility.SetDirty(r.transform);}UnityEditor.SceneManagement.EditorSceneManager.MarkSceneDirty(scene);UnityEditor.SceneManagement.EditorSceneManager.SaveScene(scene);System.IO.File.WriteAllLines("scripts/dec-ground-20261114/changes.txt",report);UnityEngine.Debug.Log(string.Join("\n",report));
