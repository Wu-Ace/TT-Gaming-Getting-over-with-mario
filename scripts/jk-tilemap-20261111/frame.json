{"name": "exec_editor_script", "arguments": {"script": "if(UnityEngine.SceneManagement.SceneManager.GetActiveScene().path!=\"Assets/Scenes/Level05_Cave.unity\")UnityEditor.SceneManagement.EditorSceneManager.OpenScene(\"Assets/Scenes/Level05_Cave.unity\");var l=UnityEngine.Object.FindObjectOfType<CampaignLevel>();var death=UnityEngine.Object.FindObjectOfType<Character.Lifecycle.Death>();death.transform.parent.position+=(UnityEngine.Vector3)l.initialSpawn-death.transform.position;var v=UnityEditor.SceneView.lastActiveSceneView;v.in2DMode=true;v.LookAt(new UnityEngine.Vector3(12,3,0),UnityEngine.Quaternion.identity,10,true,true);v.Focus();v.Repaint();UnityEditor.SceneManagement.EditorSceneManager.SaveScene(UnityEngine.SceneManagement.SceneManager.GetActiveScene());", "summary": "Show saved fifth-level Tilemap and align edit-mode character preview with spawn"}}