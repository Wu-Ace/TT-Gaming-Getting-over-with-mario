{"name": "exec_editor_script", "arguments": {"script": "for(int k=1;k<=4;k++){string path=\"Assets/Tiles/JumpKingFifth/Slope\"+k+\".png\";var ti=(UnityEditor.TextureImporter)UnityEditor.AssetImporter.GetAtPath(path);var settings=new UnityEditor.TextureImporterSettings();ti.ReadTextureSettings(settings);settings.spriteMeshType=UnityEngine.SpriteMeshType.FullRect;ti.SetTextureSettings(settings);ti.SaveAndReimport();var tile=UnityEditor.AssetDatabase.LoadAssetAtPath<UnityEngine.Tilemaps.Tile>(\"Assets/Tiles/JumpKingFifth/Slope\"+k+\".asset\");tile.name=\"Slope\"+k;UnityEditor.EditorUtility.SetDirty(tile);}UnityEditor.AssetDatabase.SaveAssets();", "summary": "Use exact full-rectangle sprite meshes so diagonal tile alpha renders without generated outline gaps"}}