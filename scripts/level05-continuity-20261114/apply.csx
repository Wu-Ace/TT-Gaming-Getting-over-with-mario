using System.Linq;
var scene=UnityEngine.SceneManagement.SceneManager.GetActiveScene();if(scene.path!="Assets/Scenes/Level05_Cave.unity"||UnityEditor.EditorApplication.isPlaying)throw new System.Exception("Wrong scene");
if(!UnityEditor.SceneManagement.EditorSceneManager.SaveScene(scene,"scripts/level05-continuity-20261114/live.before.unity",true))throw new System.Exception("Backup failed");
var map=UnityEngine.Object.FindObjectsOfType<UnityEngine.Tilemaps.Tilemap>().Single(m=>m.name.StartsWith("Jump King"));var rock=UnityEditor.AssetDatabase.LoadAssetAtPath<UnityEngine.Tilemaps.TileBase>("Assets/Tiles/JumpKingFifth/Rock.asset");if(!rock)throw new System.Exception("Missing native rock");
var fill=Codely.Newtonsoft.Json.JsonConvert.DeserializeObject<int[][]>(System.IO.File.ReadAllText("scripts/level05-continuity-20261114/fill.json"));UnityEditor.Undo.RegisterCompleteObjectUndo(map,"Repair continuous Level05 walls");int added=0;foreach(var p in fill){var c=new UnityEngine.Vector3Int(p[0],p[1],0);if(!map.HasTile(c)){map.SetTile(c,rock);added++;}}
map.RefreshAllTiles();var col=map.GetComponent<UnityEngine.Tilemaps.TilemapCollider2D>();col.ProcessTilemapChanges();UnityEngine.Physics2D.SyncTransforms();int missing=fill.Count(p=>!map.HasTile(new UnityEngine.Vector3Int(p[0],p[1],0)));if(missing!=0)throw new System.Exception("Still missing wall cells");UnityEditor.SceneManagement.EditorSceneManager.MarkSceneDirty(scene);UnityEditor.SceneManagement.EditorSceneManager.SaveScene(scene);System.IO.File.WriteAllText("scripts/level05-continuity-20261114/result.txt","Added="+added+"; missing="+missing+"; only filled gaps between originally adjacent solid cells. Existing live edits and occupied cells retained.");UnityEngine.Debug.Log("Continuous wall repair: added="+added+" missing="+missing);
