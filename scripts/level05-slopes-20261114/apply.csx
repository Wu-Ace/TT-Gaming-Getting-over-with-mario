using System.Linq;
var scene=UnityEngine.SceneManagement.SceneManager.GetActiveScene();if(scene.path!="Assets/Scenes/Level05_Cave.unity"||UnityEditor.EditorApplication.isPlaying)throw new System.Exception("Wrong scene");
if(!UnityEditor.SceneManagement.EditorSceneManager.SaveScene(scene,"scripts/level05-slopes-20261114/live.before.unity",true))throw new System.Exception("Backup failed");
var plan=Codely.Newtonsoft.Json.Linq.JObject.Parse(System.IO.File.ReadAllText("scripts/level05-slopes-20261114/plan.json"));var rows=plan["rows"].ToObject<int[]>();var old=plan["oldRows"].ToObject<int[]>();var cells=plan["cells"].ToArray();var assets=plan["guids"].Select(g=>UnityEditor.AssetDatabase.LoadAssetAtPath<UnityEngine.Tilemaps.TileBase>(UnityEditor.AssetDatabase.GUIDToAssetPath((string)g))).ToArray();if(assets.Any(t=>!t))throw new System.Exception("Asset missing");var map=UnityEngine.Object.FindObjectsOfType<UnityEngine.Tilemaps.Tilemap>().Single(m=>m.name.StartsWith("Jump King"));
var src=cells.ToDictionary(p=>new UnityEngine.Vector3Int((int)p["x"],(int)p["y"],0),p=>(int)p["index"]);
var expected=new System.Collections.Generic.Dictionary<UnityEngine.Vector3Int,UnityEngine.Tilemaps.TileBase>();foreach(var p in cells.OrderBy(p=>(int)p["y"]))expected[new UnityEngine.Vector3Int((int)p["x"],old[(int)p["y"]],0)]=assets[(int)p["index"]];foreach(var p in src.Keys)if(src.ContainsKey(p+UnityEngine.Vector3Int.up))for(int y=old[p.y];y<=old[p.y+1];y++){var q=new UnityEngine.Vector3Int(p.x,y,0);if(!expected.ContainsKey(q))expected[q]=assets[4];}
var additions=new System.Collections.Generic.Dictionary<UnityEngine.Vector3Int,UnityEngine.Tilemaps.TileBase>();var removed=new System.Collections.Generic.List<UnityEngine.Vector3Int>();foreach(var p in map.cellBounds.allPositionsWithin){var t=map.GetTile(p);if(t&&(!expected.ContainsKey(p)||expected[p]!=t))additions[p]=t;}foreach(var p in expected.Keys)if(!map.HasTile(p))removed.Add(p);
int NewRow(int y){int best=0;for(int i=0;i<old.Length;i++){if(old[i]>y)break;best=i;}return rows[best]+y-old[best];}
float NewY(float y){float q=(y+3.6f)/.4f;int k=UnityEngine.Mathf.FloorToInt(q);return -3.6f+.4f*UnityEngine.Mathf.Lerp(NewRow(k),NewRow(k+1),q-k);}
UnityEditor.Undo.RegisterCompleteObjectUndo(map,"Restore rigid slope segments");map.ClearAllTiles();foreach(var p in cells.OrderBy(p=>(int)p["y"]))map.SetTile(new UnityEngine.Vector3Int((int)p["x"],rows[(int)p["y"]],0),assets[(int)p["index"]]);foreach(var p in src.Keys)if(src.ContainsKey(p+UnityEngine.Vector3Int.up))for(int y=rows[p.y];y<=rows[p.y+1];y++){var q=new UnityEngine.Vector3Int(p.x,y,0);if(!map.HasTile(q))map.SetTile(q,assets[4]);}
foreach(var p in removed)map.SetTile(new UnityEngine.Vector3Int(p.x,NewRow(p.y),0),null);foreach(var kv in additions)map.SetTile(new UnityEngine.Vector3Int(kv.Key.x,NewRow(kv.Key.y),0),kv.Value);
var moved=new System.Collections.Generic.HashSet<UnityEngine.Transform>();void Move(UnityEngine.Transform t){if(!t||!moved.Add(t))return;UnityEditor.Undo.RecordObject(t,"Move with restored slope bands");var p=t.position;p.y=NewY(p.y);t.position=p;UnityEditor.PrefabUtility.RecordPrefabInstancePropertyModifications(t);}
var level=UnityEngine.Object.FindObjectOfType<CampaignLevel>();foreach(UnityEngine.Transform t in level.transform){if(t==map.transform.parent)continue;if(t.name=="Interactions"){foreach(UnityEngine.Transform child in t)Move(child);}else Move(t);}foreach(var r in scene.GetRootGameObjects())if(r.name.StartsWith("DEC"))foreach(UnityEngine.Transform t in r.transform)Move(t);
UnityEditor.Undo.RecordObject(level,"Move route with slope bands");for(int i=0;i<level.route.Length;i++){var p=level.route[i];p.y=NewY(p.y);level.route[i]=p;}var spawn=level.initialSpawn;spawn.y=NewY(spawn.y);level.initialSpawn=spawn;UnityEditor.EditorUtility.SetDirty(level);var d=UnityEngine.Object.FindObjectOfType<Character.Lifecycle.Death>();UnityEditor.Undo.RecordObject(d.transform.parent,"Move player entry");d.transform.parent.position+=(UnityEngine.Vector3)spawn-d.transform.position;UnityEditor.PrefabUtility.RecordPrefabInstancePropertyModifications(d.transform.parent);
map.RefreshAllTiles();map.GetComponent<UnityEngine.Tilemaps.TilemapCollider2D>().ProcessTilemapChanges();UnityEngine.Physics2D.SyncTransforms();int wanted=0,wrong=0;foreach(var p in cells){int index=(int)p["index"];if(index==0||index==4)continue;wanted++;var pos=new UnityEngine.Vector3Int((int)p["x"],rows[(int)p["y"]],0);if(map.GetTile(pos)!=assets[index])wrong++;}if(wrong>0)throw new System.Exception("Slope override conflict: "+wrong);
UnityEditor.SceneManagement.EditorSceneManager.MarkSceneDirty(scene);UnityEditor.SceneManagement.EditorSceneManager.SaveScene(scene);System.IO.File.WriteAllText("scripts/level05-slopes-20261114/applied.txt","Restored original slope cells="+wanted+" mismatches="+wrong+" live additions retained="+additions.Count+" live deletions retained="+removed.Count);UnityEngine.Debug.Log("Restored "+wanted+" original slope cells; mismatches="+wrong+" live edits="+additions.Count+"/"+removed.Count);
