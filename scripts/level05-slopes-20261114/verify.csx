using System.Linq;
var map=UnityEngine.Object.FindObjectsOfType<UnityEngine.Tilemaps.Tilemap>().Single(m=>m.name.StartsWith("Jump King"));var col=map.GetComponent<UnityEngine.Tilemaps.TilemapCollider2D>();var poly=new System.Collections.Generic.List<UnityEngine.Vector2>();int slopes=0,tests=0,wrong=0;var details=new System.Collections.Generic.List<string>();bool Inside(UnityEngine.Vector2 p,System.Collections.Generic.List<UnityEngine.Vector2> v){bool inside=false;for(int i=0,j=v.Count-1;i<v.Count;j=i++){if((v[i].y>p.y)!=(v[j].y>p.y)&&p.x<(v[j].x-v[i].x)*(p.y-v[i].y)/(v[j].y-v[i].y)+v[i].x)inside=!inside;}return inside;}
foreach(var pos in map.cellBounds.allPositionsWithin){var tile=map.GetTile(pos);if(!tile||!UnityEditor.AssetDatabase.GetAssetPath(tile).Contains("/Slope"))continue;slopes++;var sprite=map.GetSprite(pos);sprite.GetPhysicsShape(0,poly);for(int ix=0;ix<5;ix++)for(int iy=0;iy<5;iy++){var point=new UnityEngine.Vector2(-.4f+(ix+.37f)*.16f,-.4f+(iy+.29f)*.16f);var local=map.GetCellCenterLocal(pos)+(UnityEngine.Vector3)point;bool expected=Inside(point,poly),actual=col.OverlapPoint(map.transform.TransformPoint(local));tests++;if(expected!=actual){wrong++;if(details.Count<10)details.Add(pos+" "+point+" expected="+expected+" actual="+actual);}}}
var result="Slope cells="+slopes+" triangle samples="+tests+" mismatches="+wrong+"\n"+string.Join("\n",details);System.IO.File.WriteAllText("scripts/level05-slopes-20261114/collision.txt",result);UnityEngine.Debug.Log(result);
