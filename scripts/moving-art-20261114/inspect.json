{"name":"exec_editor_script","arguments":{"script":"return UnityEngine.Object.FindObjectsOfType<VerticalRidePlatform>(true).SelectMany(p=>p.GetComponentsInChildren<UnityEngine.SpriteRenderer>(true)).Select(r=>r.name+\" | \"+UnityEditor.AssetDatabase.GetAssetPath(r.sprite)+\" | \"+r.transform.lossyScale).ToArray();","summary":"Inspect omitted moving platform artwork","timeoutSeconds":60}}
