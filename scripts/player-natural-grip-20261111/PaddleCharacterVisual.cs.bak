using UnityEngine;

namespace Character.Control
{
    // Visual-only two-bone rig. Physics, joints and input remain on the original objects.
    [ExecuteAlways, DefaultExecutionOrder(200)]
    public sealed class PaddleCharacterVisual : MonoBehaviour
    {
        public Transform body, tool, tip;
        public SpriteRenderer torso, paddle, leftUpper, leftLower, rightUpper, rightLower;
        public SpriteRenderer[] legacy;
        const float Pixel = 1.8f / 311f;
        public float HandError { get; private set; }
        public float ArmReach { get; private set; }
        readonly float[] elbowAngles = new float[2];
        readonly bool[] initialized = new bool[2];
        public Vector3 LeftHand { get; private set; }
        public Vector3 RightHand { get; private set; }
        public Vector3 LeftElbow { get; private set; }
        public Vector3 RightElbow { get; private set; }
        void OnEnable() { initialized[0] = initialized[1] = false; }
        void LateUpdate() { Pose(); }
        public void Pose()
        {
            if (!body || !tool || !tip || !torso) return;
            foreach (var r in legacy) if (r) r.enabled = false;
            float growth = Mathf.Abs(body.lossyScale.x) / 7.5f;
            float px = Pixel * growth;
            Vector3 up = body.up, right = body.right;
            Vector3 origin = body.position + up * (.3f * growth);
            Place(torso, origin, Vector2.zero, Vector2.up, up, px);
            Vector3 blade = tip.position;
            Vector3 axis = -tool.right;
            // Bottom of blade stays on the existing physical contact point.
            Place(paddle, blade, new Vector2(24, 240), Vector2.up, axis, 2.15f / 230f * growth);
            Vector3 shoulderL = body.position + up * (.66f * growth) - right * (.245f * growth);
            Vector3 shoulderR = body.position + up * (.66f * growth) + right * (.245f * growth);
            // Keep two distinct grips inside both arms' reachable intervals on the shaft.
            // Physical paddle travel is unchanged; hands slide instead of stretching the arms.
            float reach = .98f * growth;
            Vector2 leftRange = GripRange(shoulderL, blade, axis, reach, growth);
            Vector2 rightRange = GripRange(shoulderR, blade, axis, reach, growth);
            if (leftRange.x > leftRange.y || rightRange.x > rightRange.y || leftRange.y - rightRange.x < .20f * growth)
            {
                // A fast physical joint can briefly leave the ideal radial arc. Find the
                // minimum shared reach for two separated grips, rather than enlarging each
                // forearm independently while its elbow catches up.
                float a0 = .85f * growth, b0 = 2.03f * growth;
                float Cost(float t) { return Mathf.Max((blade + axis * (t + .20f * growth) - shoulderL).sqrMagnitude,
                    (blade + axis * t - shoulderR).sqrMagnitude); }
                for (int i=0;i<24;i++) { float a1=(2*a0+b0)/3, b1=(a0+2*b0)/3; if(Cost(a1)<Cost(b1))b0=b1;else a0=a1; }
                reach = Mathf.Max(reach,Mathf.Sqrt(Cost((a0+b0)*.5f)) + .0001f * growth);
                leftRange = GripRange(shoulderL,blade,axis,reach,growth);
                rightRange = GripRange(shoulderR,blade,axis,reach,growth);
            }
            ArmReach = reach;
            float gap = Mathf.Min(.40f * growth, Mathf.Max(.20f * growth, leftRange.y - rightRange.x));
            float low = Mathf.Max(rightRange.x, leftRange.x - gap);
            float high = Mathf.Min(rightRange.y, leftRange.y - gap);
            float preferred = Vector3.Dot((shoulderL + shoulderR) * .5f - blade, axis) - gap * .5f;
            float grip = Mathf.Clamp(preferred, low, Mathf.Max(low,high));
            LeftHand = blade + axis * (grip + gap);
            RightHand = blade + axis * grip;
            float a = Arm(leftUpper, leftLower, shoulderL, LeftHand, -1, px, 0,
                new Vector2(16,16), new Vector2(68,70), new Vector2(13,17), new Vector2(94,16));
            float b = Arm(rightUpper, rightLower, shoulderR, RightHand, 1, px, 1,
                new Vector2(66,16), new Vector2(12,74), new Vector2(12,28), new Vector2(99,15));
            HandError = Mathf.Max(a,b);
        }
        static Vector2 GripRange(Vector3 shoulder, Vector3 blade, Vector3 axis, float reach, float growth)
        {
            Vector3 delta = shoulder - blade;
            float projected = Vector3.Dot(delta,axis);
            float sideSquared = Mathf.Max(0,delta.sqrMagnitude - projected * projected);
            float half = Mathf.Sqrt(Mathf.Max(0,reach * reach - sideSquared));
            return new Vector2(Mathf.Max(.85f * growth,projected-half),Mathf.Min(2.23f * growth,projected+half));
        }
        float Arm(SpriteRenderer upper, SpriteRenderer lower, Vector3 shoulder, Vector3 hand, float bend,
            float px, int index, Vector2 s, Vector2 e, Vector2 elbowPixel, Vector2 wristPixel)
        {
            // Natural .49m segments; only the minimum shared correction for out-of-arc physics poses.
            float length = ArmReach * .5f;
            Vector3 delta = hand - shoulder;
            float distance = delta.magnitude;
            float bodyAngle = body.eulerAngles.z;
            float angle = initialized[index] ? elbowAngles[index] : (index == 0 ? -130f : -50f);
            if (distance > .00001f)
            {
                float direction = Mathf.Atan2(delta.y,delta.x) * Mathf.Rad2Deg - bodyAngle;
                float fold = Mathf.Acos(Mathf.Clamp(distance / (2f * length),0f,1f)) * Mathf.Rad2Deg;
                float first = direction + bend * fold;
                float second = direction - bend * fold;
                // Choose the continuous elbow branch instead of smoothing an invalid pose,
                // which previously lengthened the forearm while catching up with the hand.
                angle = initialized[index] && Mathf.Abs(Mathf.DeltaAngle(angle,second)) < Mathf.Abs(Mathf.DeltaAngle(angle,first)) ? second : first;
            }
            elbowAngles[index] = angle; initialized[index] = true;
            float radians = (angle + bodyAngle) * Mathf.Deg2Rad;
            Vector3 elbow = shoulder + new Vector3(Mathf.Cos(radians),Mathf.Sin(radians),0) * length;
            Place(upper,shoulder,s,ImageDirection(e-s),elbow-shoulder,length / Vector2.Distance(s,e));
            Place(lower,elbow,elbowPixel,ImageDirection(wristPixel-elbowPixel),hand-elbow,length / Vector2.Distance(elbowPixel,wristPixel));
            if (index == 0) LeftElbow = elbow; else RightElbow = elbow;
            return Vector3.Distance(PixelPosition(lower,wristPixel),hand);
        }
        public static Vector3 PixelPosition(SpriteRenderer r, Vector2 pixel)
        {
            var local = new Vector3(pixel.x-r.sprite.pivot.x,r.sprite.rect.height-pixel.y-r.sprite.pivot.y,0) / r.sprite.pixelsPerUnit;
            return r.transform.TransformPoint(local);
        }
        static Vector2 ImageDirection(Vector2 v) { return new Vector2(v.x,-v.y); }
        static void Place(SpriteRenderer r, Vector3 anchor, Vector2 pixel, Vector2 sourceAxis, Vector3 direction, float scale)
        {
            if (!r || !r.sprite) return;
            float angle = Mathf.Atan2(direction.y,direction.x)*Mathf.Rad2Deg-Mathf.Atan2(sourceAxis.y,sourceAxis.x)*Mathf.Rad2Deg;
            var rotation=Quaternion.Euler(0,0,angle);
            // A zero pixel denotes the center anchor used by the torso.
            Vector2 local = pixel == Vector2.zero ? Vector2.zero : new Vector2(pixel.x-r.sprite.pivot.x,r.sprite.rect.height-pixel.y-r.sprite.pivot.y);
            r.transform.SetPositionAndRotation(anchor-rotation*(Vector3)(local*scale),rotation);
            float parentScale = r.transform.parent.lossyScale.x;
            r.transform.localScale=Vector3.one*(scale*r.sprite.pixelsPerUnit/parentScale);
        }
    }
}
