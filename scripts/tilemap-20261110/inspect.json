{"name": "exec_editor_script", "arguments": {"script": "var scene=UnityEngine.SceneManagement.SceneManager.GetActiveScene(); return new {scene=scene.path,dirty=scene.isDirty,playing=UnityEditor.EditorApplication.isPlaying, terrain=UnityEngine.Object.FindObjectsOfType<UnityEngine.SpriteRenderer>(true).Where(r=>r.transform.GetComponentsInParent<UnityEngine.Transform>(true).Any(t=>t.name==\"Terrain\")).Take(12).Select(r=>new {r.name,pos=r.transform.position,scale=r.transform.lossyScale,sprite=UnityEditor.AssetDatabase.GetAssetPath(r.sprite),components=r.GetComponents<UnityEngine.Component>().Select(c=>c.GetType().Name).ToArray()}).ToArray()};", "summary": "Inspect terrain before Tilemap migration"}}