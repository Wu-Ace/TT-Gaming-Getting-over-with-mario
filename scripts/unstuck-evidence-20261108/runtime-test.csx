System.Collections.IEnumerator Run() {
    GameMenuUI.Testing = true;
    var d = UnityEngine.Object.FindObjectOfType<Character.Lifecycle.Death>();
    var u = d.GetComponent<PlayerUnstuck>();
    if (u == null) throw new System.Exception("Recovery component not attached");
    var level = CampaignLevel.Current;
    foreach(var c in UnityEngine.Object.FindObjectsOfType<CampaignInteractable>()) c.gameObject.SetActive(false);
    foreach(var b in d.transform.parent.GetComponentsInChildren<UnityEngine.MonoBehaviour>()) if(b != u) b.enabled = false;
    var root = d.transform.parent;
    foreach(var rb in root.GetComponentsInChildren<UnityEngine.Rigidbody2D>()) { rb.velocity=UnityEngine.Vector2.zero; rb.angularVelocity=0; rb.constraints=UnityEngine.RigidbodyConstraints2D.FreezeAll; }
    foreach(var j in root.GetComponentsInChildren<UnityEngine.Joint2D>()) j.enabled=false; var t = typeof(PlayerUnstuck);
    var flags = System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance;
    var list = (System.Collections.IList)t.GetField("safe",flags).GetValue(u); list.Clear();
    level.route = new[]{new UnityEngine.Vector2(10000,10000),new UnityEngine.Vector2(10020,10000)};
    var bodyCollider = d.GetComponent<UnityEngine.Collider2D>();
    if(bodyCollider == null) bodyCollider=d.GetComponentInChildren<UnityEngine.Collider2D>();
    root.position += new UnityEngine.Vector3(10000,10000,0)-d.transform.position;
    UnityEngine.Physics2D.SyncTransforms();
    var floor = new UnityEngine.GameObject("Unstuck test ground");
    floor.transform.position = new UnityEngine.Vector3(10010,bodyCollider.bounds.min.y-.51f,0);
    floor.AddComponent<UnityEngine.BoxCollider2D>().size = new UnityEngine.Vector2(40,1);
    UnityEngine.Physics2D.SyncTransforms();
    foreach(var rb in root.GetComponentsInChildren<UnityEngine.Rigidbody2D>()) if(rb != d.GetComponent<UnityEngine.Rigidbody2D>()) rb.transform.position += UnityEngine.Vector3.up*3; UnityEngine.Physics2D.SyncTransforms(); yield return new UnityEngine.WaitForFixedUpdate(); floor.transform.position = new UnityEngine.Vector3(10010,bodyCollider.bounds.min.y-.51f,0); UnityEngine.Physics2D.SyncTransforms(); yield return new UnityEngine.WaitForFixedUpdate(); if(!(bool)t.GetMethod("Clear",flags).Invoke(u,new object[]{false,.025f})) { var why=""; foreach(var c in root.GetComponentsInChildren<UnityEngine.Collider2D>()){if(!c.enabled||c.isTrigger)continue;foreach(var o in UnityEngine.Physics2D.OverlapBoxAll(c.bounds.center,c.bounds.size+UnityEngine.Vector3.one*.02f,0)){if(o.transform.IsChildOf(root))continue;var dd=c.Distance(o);why+=c.name+"/"+o.name+"="+dd.distance+" trigger="+o.isTrigger+";";}} throw new System.Exception("Fixture not clear: "+why); } var start = (UnityEngine.Vector2)d.transform.position;
    var capture=t.GetMethod("Capture",flags);
    list.Add(capture.Invoke(u,null));
    root.position += UnityEngine.Vector3.right*6; UnityEngine.Physics2D.SyncTransforms();
    list.Add(capture.Invoke(u,null));
    root.position -= UnityEngine.Vector3.right*3; UnityEngine.Physics2D.SyncTransforms();
    var middle=(UnityEngine.Vector2)d.transform.position;
    yield return new UnityEngine.WaitForSeconds(.8f);
    if(u.RecoveryCount!=0) throw new System.Exception("Normal standing caused recovery");
    var block = new UnityEngine.GameObject("Generated platform overlap");
    block.transform.position=bodyCollider.bounds.center;
    block.AddComponent<UnityEngine.BoxCollider2D>().size=UnityEngine.Vector2.one*2;
    UnityEngine.Physics2D.SyncTransforms();
    yield return new UnityEngine.WaitForSeconds(1.3f);
    if(u.RecoveryCount!=1 || UnityEngine.Vector2.Distance(d.transform.position,start)>.1f) throw new System.Exception("Did not recover backward: count="+u.RecoveryCount+" pos="+d.transform.position);
    list.Clear();
    root.position += UnityEngine.Vector3.right*6; UnityEngine.Physics2D.SyncTransforms();
    list.Add(capture.Invoke(u,null));
    root.position -= UnityEngine.Vector3.right*3; UnityEngine.Physics2D.SyncTransforms();
    if(u.TryRecover()) throw new System.Exception("Forward destination accepted");
    root.position -= UnityEngine.Vector3.right*3; UnityEngine.Physics2D.SyncTransforms();
    list.Clear(); list.Add(capture.Invoke(u,null));
    var obstruction=new UnityEngine.GameObject("Blocked fallback"); obstruction.transform.position=bodyCollider.bounds.center; obstruction.AddComponent<UnityEngine.BoxCollider2D>().size=UnityEngine.Vector2.one*2;
    root.position += UnityEngine.Vector3.right*3; UnityEngine.Physics2D.SyncTransforms();
    if(u.TryRecover()) throw new System.Exception("Occupied fallback accepted");
    var vertical=new[]{UnityEngine.Vector2.zero,UnityEngine.Vector2.up*10};
    if(PlayerUnstuck.ProgressAt(UnityEngine.Vector2.up*2,vertical)>=PlayerUnstuck.ProgressAt(UnityEngine.Vector2.up*7,vertical)) throw new System.Exception("Vertical route ordering");
    var bent=new[]{UnityEngine.Vector2.zero,UnityEngine.Vector2.right*10,new UnityEngine.Vector2(10,10),new UnityEngine.Vector2(0,10)};
    if(PlayerUnstuck.ProgressAt(new UnityEngine.Vector2(8,10),bent)>=PlayerUnstuck.ProgressAt(new UnityEngine.Vector2(2,10),bent)) throw new System.Exception("Return route ordering");
    UnityEngine.Debug.Log("UNSTUCK PASS: auto attachment, normal idle, sustained overlap recovery, backward nearest pose, forward rejected, occupied fallback rejected, vertical and return route ordering. Test rig frozen; not full traversal.");
}
return Run();
